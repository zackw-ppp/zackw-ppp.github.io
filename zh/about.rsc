1:[[["$","link","css:/_next/static/css/page.Y1H9ouM5.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/page.Y1H9ouM5.css","data-rsc-css-href":"/_next/static/css/page.Y1H9ouM5.css"}],"$undefined"],["$","$Lb",null,{"page":{"route":"/about","paragraphs":["嗨，我是 Zack","我是一名产品/UX 设计师。我相信，好的设计往往先被感受到，再被看见。","我对 UX 的兴趣，起于一个很具体的细节：书页边距。它不只是空白，而是特意留出的手持空间，避免手指挡住文字。那个小小的发现改变了我对设计的理解——最好的体验，往往来自人们几乎察觉不到的决定。","这个想法至今仍在影响我的工作。我做过 B2B SaaS、消费增长、内部工具、HMI、生鲜电商和旅行产品。领域各不相同，挑战却很相似：理解逻辑、梳理混乱，让下一步变得清楚自然。","我的优势是能很快理解陌生领域，尤其是复杂产品。我喜欢弄懂系统背后的逻辑，找出混乱之处的脉络，再把困惑转化为清晰的设计决策。","我很难忍受低效。我喜欢尝试新工具、优化工作流，用一些小改动减少日常工作中的摩擦。Figma 就是一个例子：我曾两次帮助团队从 Sketch 迁移到 Figma。现在，我也在用同样的方式推动 AI 工作流——更快完成设计和原型，也做一些能为团队节省时间的小工具。","设计之外，我喜欢看漫画和动漫、拍照、追日落。我也会花很多时间规划旅行，寻找性价比最高的路线。最近我还在 Vibe Coding，做了漫画翻译和旅行规划等小工具。我喜欢围绕自己真正热爱的事情做东西。","我会说英语和中文，也会一些法语和少量日语。我仍在不断学习——语言、工具、系统，以及让事情更好运转的方法。"],"experiences":[{"company":"Sony","role":"产品设计（赞助项目）","period":"01/2026 - 06/2026","summary":"研究并设计家庭体育观赛体验，重点提升沉浸感。"},{"company":"Alibaba","role":"产品设计","period":"06/2025 - 08/2025","mobilePeriod":"06/2022 - 08/2024","summary":"设计 B2C 生鲜推荐体验，并维护设计系统。"},{"company":"Accenture","role":"UX 设计（合同项目）","period":"08/2021 - 12/2021","summary":"为长城汽车设计车载 HMI 体验。"},{"company":"Zilliz","role":"产品设计","period":"03/2021 - 06/2021","summary":"在一家早期创业公司负责向量数据库 SaaS 产品设计。"},{"company":"Ansys, Synopsys","role":"UX 设计","period":"08/2025 - 12/2025","summary":"为机械工程师使用的复杂 B2B SaaS 仿真产品提供设计。"},{"company":"Trip.com","role":"UX 设计","period":"06/2022 - 08/2024","summary":"负责 B2C 与 B2B 用车和跟团游体验，聚焦转化增长与运营提效。","mobileSummary":"负责 B2C 与 B2B 用车体验，聚焦转化增长与运营提效。"},{"company":"Bilibili","role":"产品设计","period":"06/2021 - 08/2021","summary":"负责主播端直播平台设计。","mobileSummary":"负责主播端直播平台设计。"}],"contact":{"headline":"有空一起聊聊，也一起出去走走。","email":"zackw294@outlook.com"},"decorativeMedia":{"doodle":"/assets/media/S2yPcZhuQMHwRwPOFPDbbQOPo.png","footerImage":"/assets/media/96ajI6vK6AuYf1kjML705rB4.png"},"media":["/assets/media/0g1laHvRZVXCzLWMn86fcEdAys.jpeg","/assets/media/6xMJOGYJwe0KOVEzjW0mvcG0kUk.jpeg","/assets/media/8CbPPAf3Un7zuCb4YIbA3CRP8.jpeg","/assets/media/8IMe9nvF8fh4MbyUjMFYBmP6QY.jpeg","/assets/media/96ajI6vK6AuYf1kjML705rB4.png","/assets/media/BVB1pxdTE2eQ3loF5k9o6YCheY.jpeg","/assets/media/Pt4a2UKQqqNQRK9ACEjEJrSFIFs.jpeg","/assets/media/S2yPcZhuQMHwRwPOFPDbbQOPo.png","/assets/media/YU4tQJTGWVIw6JAIvuolkrXLTk.jpeg","/assets/media/dw14tVcy0sGOZHs64cNDlFZzaU.jpeg","/assets/media/q8QUSAamPVjaourKcjPljdnDDs.jpeg"]},"locale":"zh"}]]
