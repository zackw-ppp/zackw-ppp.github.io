hildren":"01"}],["$","p",null,{"children":"Escalation can be a constructive way to break a deadlock. After repeated requirement shifts, we hit a point where a “quick fix” would push complexity onto users (e.g., negative pricing), so I escalated to reset alignment on user impact and decision principles."}]]}],["$","li",null,{"children":[["$","span",null,{"children":"02"}],["$","p",null,{"children":"Upfront scoping prevents downstream rework. The real blocker wasn’t execution—it was an under-defined scope that kept changing late in the process."}]]}]]}],["$","footer",null,{"className":"charter-project-nav","children":[["$","a",null,{"href":"/customer-service","children":[["$","span",null,{"children":["$","svg",null,{"viewBox":"0 0 32 32","aria-hidden":"true","children":["$","path",null,{"d":"M7.333 24.667 24.667 7.333M10 7.333h14.667V22","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]}],["$","strong",null,{"children":"Customer service redesign"}]]}],["$","a",null,{"href":"/motion","children":[["$","strong",null,{"children":"A fluent motion experience"}],["$","span",null,{"children":["$","svg",null,{"viewBox":"0 0 32 32","aria-hidden":"true","children":["$","path",null,{"d":"M7.333 24.667 24.667 7.333M10 7.333h14.667V22","fill":"none","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]}]]}]]}]]}]
